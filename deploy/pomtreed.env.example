# Copy to /etc/pomtreed/env (Linux; mode 0640, chown root:pomtreed, or 0600 owned by pomtreed; see deploy/INSTALL.md).
# Placeholders unless noted. systemd EnvironmentFile syntax: KEY=value, no `export`, no quotes needed.

# Required: upstream model endpoint and the only spend credential (held by pomtreed, never given to agents).
# The key itself is never an env value: write it to a file (mode 0600, owned by pomtreed) and point the _FILE variable at that path.
# The base URL is the provider's endpoint and must be the same provider as POMTREED_PI_PROVIDER below.
# The value here is OpenRouter's real endpoint (https://openrouter.ai/docs/quickstart); replace it when serving another provider.
# The base URL must not end in /v1 for Anthropic-messages models: the proxy appends /v1/messages (a /v1 base gives /v1/v1/messages).
POMTREED_MODEL_BASE_URL=https://openrouter.ai/api
POMTREED_MODEL_UPSTREAM_KEY_FILE=/etc/pomtreed/model.key

# Required: the Pi provider the model proxy serves (e.g. openrouter). Agents get a scoped token for it, never the upstream key.
POMTREED_PI_PROVIDER=openrouter

# REQUIRED EDIT: pin the agent image to an immutable reference so the daemon and the baked `pomtree` cannot skew.
# For a locally built image use its id: sha256:<id> from `docker image inspect --format '{{.Id}}' pomtree/agent:dev`;
# for a pushed image, <registry>/<repo>@sha256:<digest>. Uncomment and fill in: left as the placeholder every spawn
# fails (no such image); left commented, pomtreed uses the mutable pomtree/agent:dev tag (TODO(image-skew)).
#POMTREED_AGENT_IMAGE=sha256:REPLACE_WITH_IMAGE_ID

# Required: the egress-proxy sidecar image. pomtreed refuses to start while this is empty. It must be digest-pinned: the agent image's id
# (sha256:<id> from `docker image inspect --format '{{.Id}}' <agent image>`) or <registry>/<repo>@sha256:<digest>. The sidecar runs the agent image.
POMTREED_AGENT_EGRESS_PROXY_IMAGE=

# Required: the network reach of a spawn that names no template (the built-in code agent), which is what `pomtree spawn --task ...` starts.
# registry (recommended): the agent can reach the model proxy and the package registries only. Use this for a first run.
# none: no network at all, so an untemplated agent cannot reach the model proxy and fails with `Connection error.` (pomtreed warns at start).
#       Choose it only if every spawn names a template that sets its own egress.
POMTREED_AGENT_UNTEMPLATED_EGRESS=registry

# Required: which extensions' gated actions wait for a human approval. all: every extension; none: no approvals; or a comma list of extension names.
POMTREED_EXTENSIONS_APPROVAL=all

# Optional (defaults are safe: UI off, host listener off):
#POMTREED_UI_LISTEN=127.0.0.1:8787
# Mandatory when a chat channel (any messaging adapter) is enabled: pomtreed refuses to start without it. Unset is fine for zero channels or ui-only.
#POMTREED_MESSAGING_SENDERS=
#POMTREED_CAPACITY_MIN_DISK_FREE_BYTES=
#POMTREED_CAPACITY_MAX_CONTAINERS=
#POMTREED_DRAIN_TIMEOUT_MS=10000
# See docs/configuration.md for the naming rule, precedence and `pomtreed config show --origin`.
